{
  "name": "shuding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "install:launcher": "node scripts/install-launcher.mjs",
    "uninstall:launcher": "node scripts/install-launcher.mjs --uninstall",
    "build": "FONTCONFIG_FILE=\"$PWD/fontconfig/fonts.conf\" FONTCONFIG_PATH=\"$PWD/fontconfig\" electron-vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "preview": "FONTCONFIG_FILE=\"$PWD/fontconfig/fonts.conf\" FONTCONFIG_PATH=\"$PWD/fontconfig\" electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/test-*.mjs",
    "test:ui": "FONTCONFIG_FILE=\"$PWD/fontconfig/fonts.conf\" FONTCONFIG_PATH=\"$PWD/fontconfig\" electron scripts/test-reading-ui.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../pi/packages/agent",
    "@earendil-works/pi-ai": "file:../pi/packages/ai",
    "better-sqlite3": "^11.10.0",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
